# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development          # change to "production" on deploy

# ─── Database ─────────────────────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/ai_learning_platform
# Production example:
# MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/learneo

# ─── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_secret_at_least_32_chars

# ─── AI ───────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (required in production)
ALLOWED_ORIGINS=https://your-frontend.vercel.app

# ─── QR Code links ────────────────────────────────────────────────────────────
# The public URL of your frontend (used in QR code join links)
FRONTEND_URL=https://your-frontend.vercel.app
